# Logs — never commit. Eval/rebaseline runs write *.log; a leaked key once rode an
# eval log into the public mirror. JSON corpus/result files below stay tracked.
*.log
eval/data/*.log

# Eval: large result files are committed intentionally (they are the evidence corpus)
# No exclusions needed here — all eval/data/*.json are tracked

# Docker override file — machine-specific dev config (build: ., local paths, group_add)
# Each machine creates its own; never committed.
docker-compose.override.yml

# Docker / model weights (never commit)
*.gguf
*.bin
*.safetensors
ollama-models/

# GeoIP databases (binary, large, not for git — download separately)
data/geoip/*.mmdb
data/geoip/*.mmdb.gz
geoip/*.mmdb
geoip/*.mmdb.gz

# Pip install artifacts
=1.0.0

# Claude Code session transcripts
2026-*.txt

# Validation results (runtime output — not source code)
validation_results/

# Runtime SQLite databases (created by the application at startup)
verdix.db
cache.db
