# Verdix v0.1 — Environment Variable Reference
#
# Copy this file to .env and fill in the values for your environment.
# docker-compose reads .env automatically.
#
# Required variables are marked [REQUIRED].
# Everything else has a working default.

# =============================================================================
# Authentication
# =============================================================================

# [REQUIRED] Static admin password for the web UI.
# Choose a strong password — this is the only authentication barrier in v0.1.
VX_ADMIN_PASSWORD=changeme

# =============================================================================
# Suricata input paths
# =============================================================================

# [REQUIRED] Directory on this host containing eve.json.
# Same-host install:   /var/log/suricata   (default for apt/yum Suricata installs)
# NFS/SMB separated:  /mnt/suricata_logs  (your NFS mount point on this host)
VX_SURICATA_LOG_DIR=/var/log/suricata

# [REQUIRED] Directory on this host containing suricata.yaml.
# Same-host install:   /etc/suricata
# NFS/SMB separated:  /mnt/suricata_config
VX_SURICATA_CONFIG_DIR=/etc/suricata

# =============================================================================
# Enrichment — VirusTotal
# =============================================================================

# VirusTotal API key (free tier is sufficient for v0.1 evaluation).
# Leave blank to disable VT enrichment — the product degrades gracefully.
# Get a free key at: https://www.virustotal.com/gui/my-apikey
VX_VIRUSTOTAL_API_KEY=

# VT request timeout in seconds (default: 30).
# VX_VT_TIMEOUT_SECONDS=30

# VT cache TTL in seconds (default: 86400 = 24 hours).
# VX_VT_CACHE_TTL_SECONDS=86400

# =============================================================================
# Enrichment — GeoIP (DB-IP Community Edition, baked into the app image)
# =============================================================================

# These default to the paths where the Dockerfile bakes in the databases.
# Override only if you are mounting your own MaxMind GeoLite2 .mmdb files.
# VX_GEOIP_COUNTRY_DB_PATH=/var/lib/verdix/geoip/dbip-country-lite.mmdb
# VX_GEOIP_ASN_DB_PATH=/var/lib/verdix/geoip/dbip-asn-lite.mmdb

# =============================================================================
# Enrichment — RDAP
# =============================================================================

# RDAP request timeout in seconds (default: 15).
# VX_RDAP_TIMEOUT_SECONDS=15

# =============================================================================
# Identity — Reverse DNS
# =============================================================================

# Enable reverse DNS lookups for internal (HOME_NET) IP addresses (default: true).
# Set to false if your DNS environment is unreliable or PTR records are absent.
# VX_REVDNS_ENABLED=true

# Explicit DNS server for reverse lookups (optional).
# Useful when the container's default resolver differs from your internal DNS.
# VX_DNS_SERVER=

# Reverse DNS lookup timeout in seconds (default: 2).
# VX_REVDNS_TIMEOUT_SECONDS=2

# Reverse DNS cache TTL in seconds (default: 3600 = 1 hour).
# VX_REVDNS_CACHE_TTL_SECONDS=3600

# =============================================================================
# LLM — Ollama
# =============================================================================

# Ollama chat endpoint. Defaults to the sibling llm container.
# Override to point at an external Ollama server (dev/testing only).
# VX_OLLAMA_URL=http://llm:11434/api/chat

# Model to use for verdict generation (default: gemma4:e4b-it-q8_0).
# Change only if you have pulled a different model into the Ollama container.
# VX_OLLAMA_MODEL=gemma4:e4b-it-q8_0

# Ollama inference timeout in seconds (default: 600).
# Increase on very slow hardware; 600s covers worst-case CPU-only inference.
# VX_OLLAMA_TIMEOUT_SECONDS=600

# =============================================================================
# Triage pipeline tuning
# =============================================================================

# Seconds to wait after an alert arrives before sending it for triage (default: 30).
# This delay lets Suricata flush related flow/http/dns/tls records before the
# triage worker queries for correlated context.
# VX_FLOW_CONTEXT_DELAY_SECONDS=30

# Maximum alerts auto-analyzed per day (default: 300).
# Matches typical throughput on 16-core CPU-only reference hardware.
# Alerts beyond this cap are visible in the UI and can be analyzed on demand.
# VX_TRIAGE_DAILY_CAP=300

# Daily cap reset hour in local time, 0-23 (default: 0 = midnight).
# VX_DAILY_RESET_HOUR=0

# EVE tailer polling interval in milliseconds (default: 500).
# 500 ms works correctly over NFS and SMB mounts.
# VX_EVE_POLL_INTERVAL_MS=500

# =============================================================================
# Retention
# =============================================================================

# Retention period for raw EVE context events in days (default: 7).
# Alerts, verdicts, and dispositions are kept indefinitely.
# VX_EVE_CONTEXT_RETENTION_DAYS=7

# =============================================================================
# Storage
# =============================================================================

# SQLite database path inside the container (default: inside the named volume).
# VX_DB_PATH=/var/lib/verdix/verdix.db

# =============================================================================
# Web server
# =============================================================================

# Bind address (default: 0.0.0.0 — all interfaces).
# VX_HOST=0.0.0.0

# Port to listen on (default: 8080). Change if 8080 is in use on your host.
# VX_PORT=8080

# Log level: DEBUG, INFO, WARNING, ERROR (default: INFO).
# VX_LOG_LEVEL=INFO

# =============================================================================
# Proxy and TLS
# =============================================================================

# Standard proxy environment variables — respected by all outbound HTTP calls.
# Uncomment and fill in if your network routes traffic through a forward proxy.
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,llm,127.0.0.1

# Standard CA bundle override — takes precedence over VX_CA_BUNDLE_PATH.
# SSL_CERT_FILE=/path/to/ca-bundle.pem

# Path to a custom CA bundle mounted into the container (optional).
# Required if your network uses a TLS-inspecting proxy with a private CA.
# Mount the file via docker-compose: - /path/to/ca-bundle.pem:/host/certs/ca-bundle.pem:ro
# VX_CA_BUNDLE_PATH=/host/certs/ca-bundle.pem


# =============================================================================
# Feedback
# =============================================================================

# HTTPS endpoint that receives in-app feedback and data-deletion requests.
# Defaults to the Verdix-hosted receiver. Point it at your own server (the local
# dev receiver in server/telemetry/ is one option) or leave it blank to keep
# feedback local-only — when unset, nothing is sent off the deployment.
VX_FEEDBACK_ENDPOINT=https://verdix.dev/api/feedback

# Shared feedback token. Ships with the app; must equal the verdix.dev receiver's
# feedback_token. Public/anti-junk only — NOT a secret, NOT per-user.
VX_FEEDBACK_TOKEN=9c63171aa966898c055ec5a6cf0d2aadc9f0b259ee63a66223392bfd3a968dff
